# Пример локальной конфигурации Docker Compose.
# Скопируйте в .env только если нужно поменять порты. Файл .env исключён из Git.
# Секреты (пароли, токены, ключи) здесь НЕ хранятся: они лежат в каталоге secrets/,
# который создаёт infrastructure/secrets/GenerateSecrets.java.

# Порты на локальной машине (привязаны к 127.0.0.1)
POSTGRES_HOST_PORT=5432
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
# API Gateway (API и общий Swagger UI)
GATEWAY_HOST_PORT=8000

# Email первого администратора (пароль генерируется в secrets/auth_initial_admin_password)
FITCLUB_AUTH_INITIAL_ADMIN_EMAIL=admin@fitclub.local

# Профили сервисов. docker — рабочий режим: тестовое завершение оплаты (симулятор) выключено.
# Для демонстрации лабораторной включите demo: появится POST /api/payments/{id}/simulate.
# FITCLUB_PROFILES=docker,demo
